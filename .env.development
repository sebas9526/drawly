###############################################################################
# Drawly — Local development
# -----------------------------------------------------------------------------
# Ready to use as-is: `cp .env.development .env` and run `docker compose up
# --build`. Every value below is a non-secret local default (same ones
# docker-compose.yml itself falls back to) — safe to commit and share.
#
# Need the full explanation of each variable? See .env.example.
# Deploying instead? See .env.production.example + docs/deployment/DEPLOYMENT.md.
###############################################################################

ENVIRONMENT=development

# --- PostgreSQL (docker-compose's own container) ---
POSTGRES_USER=drawly
POSTGRES_PASSWORD=drawly
POSTGRES_DB=drawly
POSTGRES_PORT=5433

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- API ---
APP_NAME=Drawly API
API_PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1
# Left blank: docker-compose.yml builds both from the POSTGRES_* values above
# and points them at its own `postgres` service.
DATABASE_URL=
DATABASE_URL_SYNC=
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_SECRET=dev-insecure-change-me-in-production-please-32b
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
AUTH_COOKIE_NAME=drawly_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# --- Reservations ---
RESERVATION_TTL_HOURS=48
RESERVATION_SWEEP_ENABLED=true
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_RESERVE_MAX_REQUESTS=10
RATE_LIMIT_RESERVE_WINDOW_SECONDS=60

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
