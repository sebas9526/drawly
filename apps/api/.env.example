# See ../../.env.example for the full docker-compose env.
APP_NAME=Drawly API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://drawly:drawly@localhost:5432/drawly
DATABASE_URL_SYNC=postgresql+psycopg://drawly:drawly@localhost:5432/drawly
BACKEND_CORS_ORIGINS=http://localhost:3000
