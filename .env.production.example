###############################################################################
# Drawly — Production reference (Vercel + Render + Neon)
# -----------------------------------------------------------------------------
# NOT consumed directly — Vercel and Render each have their own environment
# variable UI; there is no single ".env" file in production. This file is a
# copy-paste reference for what to set in each dashboard (or in render.yaml /
# Vercel project settings), with the values that MUST differ from local dev
# called out. Full walkthrough: docs/deployment/DEPLOYMENT.md.
#
# Placeholders only — never put real secrets in a file tracked by git.
###############################################################################


###############################################################################
# RENDER — apps/api (Root Directory: apps/api, Runtime: Docker)
###############################################################################

ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Neon (PostgreSQL) ---
# Two URLs, two drivers, two DIFFERENT ssl query params — this is the #1
# production connection failure if mixed up:
#   DATABASE_URL      (asyncpg) -> query param is `ssl`, NOT `sslmode`.
#                                  asyncpg.connect() has no `sslmode` kwarg at
#                                  all; passing it raises a TypeError.
#   DATABASE_URL_SYNC (psycopg) -> query param is `sslmode` (libpq-style,
#                                  psycopg's native convention).
# Use Neon's DIRECT connection string (not the "-pooler" / PgBouncer one) —
# asyncpg's prepared-statement caching is incompatible with PgBouncer's
# transaction pooling mode unless separately configured. See DEPLOYMENT.md.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-PROJECT.neon.tech/drawly?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@YOUR-PROJECT.neon.tech/drawly?sslmode=require

# The deployed Vercel origin(s). Comma-separated if you also keep a preview
# domain. No wildcard, no trailing slash — allow_credentials=True requires an
# exact origin match.
BACKEND_CORS_ORIGINS=https://your-app.vercel.app

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# render.yaml does this automatically via `generateValue: true` on a Blueprint
# deploy — only set it by hand if configuring the service manually.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
AUTH_COOKIE_NAME=drawly_access
# MUST be true+none together in production: the frontend (vercel.app) and API
# (onrender.com) are different sites, so this is a genuinely cross-site
# request. SameSite=Lax (the local-dev default) is silently NOT sent on
# cross-site fetch()/XHR — only Secure+None survives the round trip, and
# SameSite=None is rejected by browsers unless Secure is also true.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# --- Reservations / rate limiting ---
# Defaults are production-sane; override only if you have a reason to.
# RESERVATION_TTL_HOURS=48
# RESERVATION_SWEEP_ENABLED=true
# RESERVATION_SWEEP_INTERVAL_SECONDS=60
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_MAX_REQUESTS=5
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
# RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
# RATE_LIMIT_RESERVE_MAX_REQUESTS=10
# RATE_LIMIT_RESERVE_WINDOW_SECONDS=60
#
# NOTE (see docs/deployment/DEPLOYMENT.md "Riesgos pendientes"): the sweep and
# the rate limiter both live in a single process's memory. Fine on Render's
# default single instance; if the service is ever scaled to >1 instance, each
# instance limits/sweeps independently (rate limits become N times looser,
# the sweep runs redundantly N times — harmless but wasteful).


###############################################################################
# VERCEL — apps/web (Root Directory: apps/web, Framework: Next.js)
###############################################################################

# The Render service's public URL, no trailing slash. Baked into the client
# bundle at build time (see turbo.json's build.env) — changing it requires a
# new build, not just a redeploy of the same build output.
NEXT_PUBLIC_API_URL=https://drawly-api.onrender.com
