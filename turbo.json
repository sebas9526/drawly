{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      // NEXT_PUBLIC_API_URL is inlined into the client bundle at build time.
      // Declared here so Turborepo's cache key (and Vercel Remote Cache) treat
      // a build against a different API URL as a cache miss, instead of
      // silently reusing a bundle baked for the wrong backend.
      "env": ["NEXT_PUBLIC_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    // Only apps/web has both a "build" and "typecheck" script, and its
    // typecheck (tsc --noEmit) reads .next/types/**, which only `next build`
    // generates. Without this, Turbo runs both tasks in parallel and
    // typecheck can race ahead of a half-written .next directory. No-op for
    // every other package (none define a "build" script).
    "typecheck": {
      "dependsOn": ["build"]
    },
    "format": {}
  }
}
