###############################################################################
# Drawly — Environment Variables (reference / local development)
# -----------------------------------------------------------------------------
# Copy this file to .env for local development (docker compose reads .env
# automatically). Every variable name here matches a field on
# apps/api/app/core/config.py::Settings exactly — pydantic-settings maps
# UPPER_SNAKE_CASE env vars to the field of the same name (case-insensitive).
#
# For a from-scratch local setup, .env.development is a ready-to-copy variant
# of this file with concrete (non-secret) values already filled in.
# For deploying to Vercel + Render + Neon, see .env.production.example and
# docs/deployment/DEPLOYMENT.md — production values are never stored here.
#
# Never commit your real .env file (already gitignored).
###############################################################################

###############################################################################
# General
###############################################################################

# development | production. Informational — no behavior currently branches on
# it directly, but keep it accurate (logging/monitoring will read it later).
ENVIRONMENT=development

###############################################################################
# PostgreSQL (docker-compose's own `postgres` service — not read by the API
# directly; DATABASE_URL/DATABASE_URL_SYNC below are built from these when
# running via docker compose. Irrelevant if you point DATABASE_URL at Neon
# instead of the local container.)
###############################################################################

POSTGRES_USER=drawly
POSTGRES_PASSWORD=drawly
POSTGRES_DB=drawly
# Host port the container publishes on (mapped to Postgres' own 5432 inside).
POSTGRES_PORT=5433

###############################################################################
# pgAdmin (docker-compose only — local DB browser, http://localhost:5050)
###############################################################################

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

###############################################################################
# API (apps/api — FastAPI)
###############################################################################

APP_NAME=Drawly API
# Host port docker-compose publishes the API on.
API_PORT=8000
# Verbose SQL echo + FastAPI debug pages. Always false outside local dev.
DEBUG=true
API_V1_PREFIX=/api/v1

# SQLAlchemy connection strings — two drivers, two URLs:
#   DATABASE_URL      -> asyncpg, used by the running app (async engine).
#   DATABASE_URL_SYNC -> psycopg, used by Alembic migrations (sync engine).
# Left empty here on purpose: docker-compose.yml overrides both to point at
# its own `postgres` service. Set both explicitly if running the API outside
# Docker (e.g. `uv run uvicorn ...` directly against local Postgres or Neon).
DATABASE_URL=
DATABASE_URL_SYNC=

# Comma-separated list of allowed origins for the browser-facing API (CORS).
# No wildcard — allow_credentials=True requires exact origins.
BACKEND_CORS_ORIGINS=http://localhost:3000

###############################################################################
# Authentication (JWT carried in an httpOnly cookie)
###############################################################################

# Signs every access token. The code ships a dev-only fallback value that
# works locally with zero setup — MUST be overridden with a long random
# secret in any deployed environment (see .env.production.example).
JWT_SECRET=dev-insecure-change-me-in-production-please-32b
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

AUTH_COOKIE_NAME=drawly_access
# false only works over plain http (local dev). Must be true wherever the API
# is served over https — which is every real deployment.
AUTH_COOKIE_SECURE=false
# lax works when frontend and API share a site (e.g. both on localhost, or a
# reverse-proxied setup on one domain). Set to `none` (plus SECURE=true) the
# moment the frontend and API live on different domains, e.g. Vercel + Render
# — otherwise the browser silently drops the cookie on cross-site requests.
AUTH_COOKIE_SAMESITE=lax

###############################################################################
# Reservations — TTL + the automatic expiry sweep (Sprint 10)
###############################################################################

# Hours a ticket reservation stays valid before it's eligible for release.
RESERVATION_TTL_HOURS=48
# In-process background sweep (no external cron) that releases expired
# reservations back to AVAILABLE. Safe to disable for a one-off script/worker
# that shouldn't also run the sweep.
RESERVATION_SWEEP_ENABLED=true
RESERVATION_SWEEP_INTERVAL_SECONDS=60

###############################################################################
# Rate limiting — in-memory, single-process (Sprint 10)
###############################################################################

RATE_LIMIT_ENABLED=true
# /auth/login and /auth/register.
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Every route under /public/*.
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
# POST /public/raffles/{slug}/reserve specifically (stacked on top of the
# public bucket above).
RATE_LIMIT_RESERVE_MAX_REQUESTS=10
RATE_LIMIT_RESERVE_WINDOW_SECONDS=60

###############################################################################
# Web (apps/web — Next.js)
###############################################################################

# Host port docker-compose publishes the web app on.
WEB_PORT=3000
# Root API origin, no trailing slash, no /api/v1 suffix (the client appends
# API_V1_PREFIX itself). Baked into the client bundle at build time — see
# turbo.json's `build.env` for why that matters for caching.
NEXT_PUBLIC_API_URL=http://localhost:8000
