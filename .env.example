# Copy this file to .env and adjust values for your machine.
# This file is consumed by docker-compose.yml for local development.
# Never commit the real .env file.

# --- General ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=drawly
POSTGRES_PASSWORD=drawly
POSTGRES_DB=drawly
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- API (FastAPI) ---
API_PORT=8000
APP_NAME=Drawly API
DEBUG=true
API_V1_PREFIX=/api/v1
# Built from the Postgres values above when running via docker-compose.
DATABASE_URL=postgresql+asyncpg://drawly:drawly@postgres:5432/drawly
DATABASE_URL_SYNC=postgresql+psycopg://drawly:drawly@postgres:5432/drawly
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
WEB_PORT=3000
# Root API origin (unversioned). Prefix individual requests with API_V1_PREFIX
# (see @drawly/config) once versioned endpoints exist.
NEXT_PUBLIC_API_URL=http://localhost:8000
